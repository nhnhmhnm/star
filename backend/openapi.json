{
  "openapi": "3.1.0",
  "info": {
    "title": "Star API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Read Health",
        "operationId": "read_health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/config/public": {
      "get": {
        "tags": [
          "config"
        ],
        "summary": "Read Public Config",
        "operationId": "read_public_config_config_public_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicConfigResponse"
                }
              }
            }
          }
        }
      }
    },
    "/sessions/visitors": {
      "post": {
        "tags": [
          "sessions"
        ],
        "summary": "Create Visitor Session",
        "operationId": "create_visitor_session_sessions_visitors_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VisitorSessionCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VisitorSessionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "appName": {
            "type": "string",
            "title": "Appname"
          },
          "environment": {
            "type": "string",
            "title": "Environment"
          }
        },
        "type": "object",
        "required": [
          "status",
          "appName",
          "environment"
        ],
        "title": "HealthResponse"
      },
      "PublicConfigResponse": {
        "properties": {
          "nightAltitudeThresholdDeg": {
            "type": "number",
            "title": "Nightaltitudethresholddeg"
          },
          "presenceCellSizeDeg": {
            "type": "number",
            "title": "Presencecellsizedeg"
          },
          "presenceHeartbeatSeconds": {
            "type": "integer",
            "title": "Presenceheartbeatseconds"
          }
        },
        "type": "object",
        "required": [
          "nightAltitudeThresholdDeg",
          "presenceCellSizeDeg",
          "presenceHeartbeatSeconds"
        ],
        "title": "PublicConfigResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VisitorSessionCreateRequest": {
        "properties": {
          "displayName": {
            "type": "string",
            "title": "Displayname"
          }
        },
        "type": "object",
        "required": [
          "displayName"
        ],
        "title": "VisitorSessionCreateRequest"
      },
      "VisitorSessionResponse": {
        "properties": {
          "participantId": {
            "type": "string",
            "format": "uuid",
            "title": "Participantid"
          },
          "displayName": {
            "type": "string",
            "title": "Displayname"
          },
          "expiresAtUtcMs": {
            "type": "integer",
            "title": "Expiresatutcms"
          }
        },
        "type": "object",
        "required": [
          "participantId",
          "displayName",
          "expiresAtUtcMs"
        ],
        "title": "VisitorSessionResponse"
      }
    }
  }
}
